{
    "name": "omnitrade/shopify",
    "type": "library",
    "description": "Omnitrade Shopify: a sale paid on the shop's invoice page (draft orders), the shop's orders, its catalogue (products, variants, inventory) and its webhooks, over the Admin GraphQL API.",
    "keywords": ["shopify", "commerce", "omnitrade"],
    "license": "LGPL-3.0-or-later",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "glitchr/omnitrade": "^1.0@dev",
        "psr/log": "^1.1|^2.0|^3.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {"phpunit/phpunit": "^11.0", "symfony/http-client": "^6.4|^7.0|^8.0"},
    "suggest": {"symfony/http-client": "The HTTP client the gateway talks through"},
    "autoload": {"psr-4": {"Omnitrade\\Shopify\\": ""}, "exclude-from-classmap": ["/Tests/"]},
    "autoload-dev": {"psr-4": {"Omnitrade\\Shopify\\Tests\\": "Tests/"}},
    "config": {"sort-packages": true}
}
